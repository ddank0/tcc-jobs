# Contratos de arquitetura: Functional Core, Imperative Shell.
#
# O núcleo funcional são transformações puras - recebem dados, devolvem dados.
# A casca imperativa faz I/O: HTTP, banco, disco, CLI.
#
# Estes contratos transformam o RNF01 ("arquitetura modular") de afirmação em
# critério verificável: a violação quebra o build, em vez de depender de
# inspeção manual.

[importlinter]
root_package = tcc_jobs

# Os contratos crescem junto com o código: cada módulo novo do núcleo entra
# aqui na mesma tarefa que o cria. Hoje cobrem o que existe.

[importlinter:contract:camadas]
name = A casca depende do núcleo, nunca o contrário
type = layers
layers =
    tcc_jobs.cli
    tcc_jobs.etl.pipeline | tcc_jobs.ml.runner
    tcc_jobs.db | tcc_jobs.portal
    tcc_jobs.etl.parsers | tcc_jobs.etl.armazenamento | tcc_jobs.etl.agregacao | tcc_jobs.ml.forecast | tcc_jobs.ml.evaluation
    tcc_jobs.core
# exhaustive não serve aqui: exige containers, e com container o ranqueamento
# passa a ser por filho direto de tcc_jobs, perdendo a granularidade dentro de
# etl. Quem garante que módulo novo entre nas camadas é
# test_contratos_arquitetura.py - agregacao ficou de fora ao ser criada na T10
# e podia importar a casca de disco sem que nada acusasse.
exhaustive = false

[importlinter:contract:core-e-independente]
name = core não conhece infraestrutura
type = forbidden
source_modules =
    tcc_jobs.core
forbidden_modules =
    tcc_jobs.db
    tcc_jobs.portal
    tcc_jobs.cli

[importlinter:contract:modelos-nao-conhecem-sessao]
name = Modelos declaram esquema, não abrem conexão
type = forbidden
source_modules =
    tcc_jobs.db.models
forbidden_modules =
    tcc_jobs.db.session
    tcc_jobs.cli

[importlinter:contract:portal-nao-conhece-banco]
name = O cliente da fonte não conhece persistência
type = forbidden
source_modules =
    tcc_jobs.portal
forbidden_modules =
    tcc_jobs.db

[importlinter:contract:nucleo-etl-e-puro]
name = Parsers e armazenamento não conhecem banco nem rede
type = forbidden
source_modules =
    tcc_jobs.etl.parsers
    tcc_jobs.etl.agregacao
    tcc_jobs.etl.armazenamento
    tcc_jobs.ml.forecast
    tcc_jobs.ml.evaluation
forbidden_modules =
    tcc_jobs.db
    tcc_jobs.portal
    tcc_jobs.cli

[importlinter:contract:ml-nao-conhece-etl]
name = ml e etl se comunicam por tabelas, não por import
type = independence
modules =
    tcc_jobs.ml
    tcc_jobs.etl
